# PostgreSQL (порт 5433 — 5432 занят другим сервером в WSL)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=opencodeai
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+psycopg://app_user:change-me@127.0.0.1:5433/opencodeai

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGIN_LIST=http://localhost:5173

# приложение читает файл окружения по этому пути, если переменная не задана в окружении
ENV_FILE=
